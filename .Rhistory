perms %>% 
  filter(p.cluster_mass < 0.05, Factor %in% c("burst_count", "burst_count:condition")) %>%
  group_by(tertile, Factor, cluster) %>%
  summarise(
    n_timepoints = n(),
    t_start = min(time),
    t_end = max(time),
    p = first(p.cluster_mass)
