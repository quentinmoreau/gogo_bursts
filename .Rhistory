Rscript
library(readxl); library(tidyverse)
age_lookup <- readxl::read_excel(clinical_xlsx) %>%
  rename_with(tolower) %>%
  rename_with(~ gsub(" ", "_", .x)) %>%
  select(subject_id = study_id, age = age) %>%
  mutate(subject_id = as.character(subject_id)) %>%
  distinct(subject_id, .keep_all = TRUE)
df <- read_csv(file.path(data_dir, "beta_power_STIM_contra_trials.csv"), show_col_types = FALSE) %>%
  mutate(subject_id = as.character(subject_id)) %>%
  left_join(age_lookup, by = "subject_id") %>%
  filter(!is.na(response_time), !is.na(age), response_time > 0) %>%
  mutate(condition = factor(condition))
cat("Overall condition counts:\n")
print(table(df$condition))
cat("\nPer-subject trial_idx continuity check:\n")
check <- df %>%
  group_by(subject_id) %>%
  summarise(n = n(), min_idx = min(trial_idx), max_idx = max(trial_idx),
            n_unique = n_distinct(trial_idx), .groups = "drop")
print(check, n = 30)
cat("\nAfter lead() + contiguity filter, condition counts:\n")
df_next <- df %>%
  arrange(subject_id, trial_idx) %>%
  group_by(subject_id) %>%
  mutate(trial_idx_next = lead(trial_idx),
         response_time_ms_next = lead(as.numeric(response_time) * 1000)) %>%
  ungroup() %>%
  filter(!is.na(response_time_ms_next), trial_idx_next == trial_idx + 1)
print(table(df_next$condition))
cat(sprintf("\nRows before: %d, rows after lead+contiguity filter: %d\n", nrow(df), nrow(df_next)))
for (i in seq_along(burst_cols)) {
  tcol <- burst_cols[i]
  time_val <- times[i]
  df_model <- df_t %>%
    mutate(burst_count = .data[[tcol]])
  model <- tryCatch({
    glmer(
      response_time_ms ~ burst_count * age_c + trial_idx_s + (1 | subject_id),
      data = df_model,
      family = Gamma(link = "log"),
      control = glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 1e6)),
      verbose = 0
    )
  }, error = function(e) {
    cat(sprintf("  [T%d time %.3f] Model fit failed: %s\n", tert, time_val, e$message))
    return(NULL)
  })
  
  if (is.null(model)) next
  
  coef_tbl <- summary(model)$coefficients
  
  # Debug: print column names
  if (i == 1) {
    cat(sprintf("  Column names: %s\n", paste(colnames(coef_tbl), collapse=" | ")))
  }
  
  break  # Just check the first one
}
