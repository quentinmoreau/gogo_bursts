library(tidyverse)

data_dir <- "/home/qmoreau/gogo_bursts/stat_output"
pc <- 12
epoch <- "RESP"

# Load the CSV
df <- read_csv(paste0(data_dir, "/PC_", pc, "_", epoch, "_trial_burst_counts.csv"),
               show_col_types = FALSE)

cat("=== CSV STRUCTURE ===\n\n")

cat("Total columns:", ncol(df), "\n")
cat("Total rows:", nrow(df), "\n\n")

cat("Column names:\n")
print(colnames(df))

cat("\n\n=== TIME COLUMNS ===\n\n")

time_cols <- grep("^time_", names(df), value = TRUE)
cat("Total time columns:", length(time_cols), "\n")
cat("First 10 time columns:\n")
print(head(time_cols, 10))

cat("\n\n=== SAMPLE DATA ===\n\n")

cat("First 5 rows, first 10 columns:\n")
print(df[1:5, 1:10])

cat("\n\n=== BURST VALUES AT ONE TIMEPOINT ===\n\n")

tcol <- "time_0.025"
cat(sprintf("Values in column '%s':\n", tcol))
print(df[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df[[tcol]], na.rm = TRUE))
cat(sprintf("Variance: %.3f\n", var(df[[tcol]], na.rm = TRUE)))
cat(sprintf("N non-zero: %d / %d\n", sum(df[[tcol]] > 0), nrow(df)))

cat("\n\n=== CHECK: TERTILE STRUCTURE ===\n\n")

cat("Unique tertiles:\n")
print(unique(df$tertile))

cat("\nTertile 1 sample (time_0.025):\n")
df_t1 <- df %>% filter(tertile == 1)
print(df_t1[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df_t1[[tcol]], na.rm = TRUE)))

cat("\nTertile 2 sample (time_0.025):\n")
df_t2 <- df %>% filter(tertile == 2)
print(df_t2[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df_t2[[tcol]], na.rm = TRUE)))

cat("\nTertile 3 sample (time_0.025):\n")
df_t3 <- df %>% filter(tertile == 3)
print(df_t3[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df_t3[[tcol]], na.rm = TRUE)))

cat("\n\n=== HYPOTHESIS CHECK ===\n\n")

cat("If combined, mean should be weighted sum:\n")
combined_mean <- mean(df[[tcol]], na.rm = TRUE)
cat(sprintf("Combined mean: %.3f\n", combined_mean))

t1_mean <- mean(df_t1[[tcol]], na.rm = TRUE)
t2_mean <- mean(df_t2[[tcol]], na.rm = TRUE)
t3_mean <- mean(df_t3[[tcol]], na.rm = TRUE)

n1 <- nrow(df_t1)
n2 <- nrow(df_t2)
n3 <- nrow(df_t3)

expected_combined <- (t1_mean * n1 + t2_mean * n2 + t3_mean * n3) / (n1 + n2 + n3)
cat(sprintf("Expected combined (weighted average): %.3f\n", expected_combined))
cat(sprintf("Match? %s\n", ifelse(abs(combined_mean - expected_combined) < 0.01, "YES ✓", "NO ✗")))
library(tidyverse)

data_dir <- "/home/qmoreau/gogo_bursts/stat_output"
pc <- 12
epoch <- "RESP"

# Load the CSV
df <- read_csv(paste0(data_dir, "/PC_", pc, "_", epoch, "_trial_burst_counts.csv"),
               show_col_types = FALSE)

cat("=== CSV STRUCTURE ===\n\n")

cat("Total columns:", ncol(df), "\n")
cat("Total rows:", nrow(df), "\n\n")

cat("Column names:\n")
print(colnames(df))

cat("\n\n=== TIME COLUMNS ===\n\n")

time_cols <- grep("^time_", names(df), value = TRUE)
cat("Total time columns:", length(time_cols), "\n")
cat("First 10 time columns:\n")
print(head(time_cols, 10))

cat("\n\n=== SAMPLE DATA ===\n\n")

cat("First 5 rows, first 10 columns:\n")
print(df[1:5, 1:10])

cat("\n\n=== BURST VALUES AT ONE TIMEPOINT ===\n\n")

tcol <- "time_0.025"
cat(sprintf("Values in column '%s':\n", tcol))
print(df[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df[[tcol]], na.rm = TRUE)))
cat(sprintf("Variance: %.3f\n", var(df[[tcol]], na.rm = TRUE)))
cat(sprintf("N non-zero: %d / %d\n", sum(df[[tcol]] > 0), nrow(df)))

cat("\n\n=== CHECK: TERTILE STRUCTURE ===\n\n")

cat("Unique tertiles:\n")
print(unique(df$tertile))

cat("\nTertile 1 sample (time_0.025):\n")
df_t1 <- df %>% filter(tertile == 1)
print(df_t1[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df_t1[[tcol]], na.rm = TRUE)))

cat("\nTertile 2 sample (time_0.025):\n")
df_t2 <- df %>% filter(tertile == 2)
print(df_t2[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df_t2[[tcol]], na.rm = TRUE)))

cat("\nTertile 3 sample (time_0.025):\n")
df_t3 <- df %>% filter(tertile == 3)
print(df_t3[[tcol]][1:20])
cat(sprintf("Mean: %.3f\n", mean(df_t3[[tcol]], na.rm = TRUE)))

cat("\n\n=== HYPOTHESIS CHECK ===\n\n")

cat("If combined, mean should be weighted sum:\n")
combined_mean <- mean(df[[tcol]], na.rm = TRUE)
cat(sprintf("Combined mean: %.3f\n", combined_mean))

t1_mean <- mean(df_t1[[tcol]], na.rm = TRUE)
t2_mean <- mean(df_t2[[tcol]], na.rm = TRUE)
t3_mean <- mean(df_t3[[tcol]], na.rm = TRUE)

n1 <- nrow(df_t1)
n2 <- nrow(df_t2)
n3 <- nrow(df_t3)

expected_combined <- (t1_mean * n1 + t2_mean * n2 + t3_mean * n3) / (n1 + n2 + n3)
cat(sprintf("Expected combined (weighted average): %.3f\n", expected_combined))
cat(sprintf("Match? %s\n", ifelse(abs(combined_mean - expected_combined) < 0.01, "YES ✓", "NO ✗")))
